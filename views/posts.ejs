<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Posts</title>
  <link rel="stylesheet" href="/stylesheets/profile.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>
  <nav class="navbar">
   <a href="/" class="logo">
  <img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Pinterest-logo.png" 
       alt="Pinterest" style="height: 30px; width: auto; vertical-align: middle;">
  Pinterest
</a>
    <div class="nav-links">
      <a href="/feed" class="nav-link"><i class="bi bi-house-fill"></i> Feed</a>
      <a href="/profile" class="nav-link"><i class="bi bi-person-fill"></i> Profile</a>
      <a href="/posts" class="nav-link"><i class="bi bi-grid-fill"></i> Posts</a>
      <a href="/logout" class="btn-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
  </nav>

  <main class="container">
    <div class="posts-section" style="padding: 2rem;">
      <h3 class="posts-title">My Posts</h3>

      <% if (user.posts.length === 0) { %>
        <p>No posts yet. Go to your profile and add one!</p>
      <% } else { %>
        <div class="cards">
          <% user.posts.forEach(function(post) { %>
             <a href="/post/<%= post._id %>" style="text-decoration:none; color:inherit;">
    <div class="card">
      <img src="<%= post.image %>" alt="Post Image" class="post-image">
      <p style="padding: 8px;"><%= post.imageText %></p>
            </div>
          <% }) %>
        </div>
      <% } %>

    </div>
  </main>

</body>
</html>