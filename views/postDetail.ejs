<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.imageText %></title>
  <link rel="stylesheet" href="/stylesheets/profile.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
  <style>
    .post-detail-container {
      max-width: 800px;
      margin: 40px auto;
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0,0,0,0.15);
      display: flex;
      flex-direction: column;
    }
    .post-detail-image {
      width: 100%;
      max-height: 500px;
      object-fit: cover;
    }
    .post-detail-info {
      padding: 24px;
    }
    .post-detail-info h2 {
      margin: 0 0 8px;
      font-size: 22px;
    }
    .post-detail-info p {
      color: #555;
      font-size: 14px;
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin: 20px;
      background: #e60023;
      color: white;
      padding: 10px 20px;
      border-radius: 25px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">
      <img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Pinterest-logo.png" 
           alt="Pinterest" style="height:30px; width:auto; vertical-align:middle;">
      Pinterest
    </a>
    <div class="nav-links">
      <a href="/feed" class="nav-link"><i class="bi bi-house-fill"></i> Feed</a>
      <a href="/profile" class="nav-link"><i class="bi bi-person-fill"></i> Profile</a>
      <a href="/posts" class="nav-link"><i class="bi bi-grid-fill"></i> Posts</a>
      <a href="/logout" class="btn-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
  </nav>

  <a href="/posts" class="back-btn"><i class="bi bi-arrow-left"></i> Back to Posts</a>

  <div class="post-detail-container">
   <img src="<%= post.image %>" alt="<%= post.imageText %>" class="post-detail-image">
    <div class="post-detail-info">
      <h2><%= post.imageText %></h2>
      <p>Posted by <strong><%= post.user ? post.user.username : 'Unknown' %></strong></p>
      <p><i class="bi bi-clock"></i> <%= new Date(post.createdAt).toDateString() %></p>
    </div>
  </div>

</body>
</html>