<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed</title>
    <link rel="stylesheet" href="/stylesheets/feed.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <style>
        .search-bar {
            display: flex;
            justify-content: center;
            padding: 20px;
        }
        .search-bar input {
            width: 50%;
            padding: 12px 20px;
            border: 2px solid #ddd;
            border-radius: 25px 0 0 25px;
            font-size: 15px;
            outline: none;
            border-right: none;
        }
        .search-bar input:focus { border-color: #e60023; }
        .search-bar button {
            padding: 12px 20px;
            background: #e60023;
            color: white;
            border: none;
            border-radius: 0 25px 25px 0;
            cursor: pointer;
            font-size: 15px;
        }
        .search-result-text {
            text-align: center;
            font-size: 14px;
            color: #555;
            margin-bottom: 10px;
        }
        .no-results {
            text-align: center;
            padding: 40px;
            font-size: 16px;
            color: #555;
        }
    </style>
</head>
<body>
    <nav class="navbar">
      <a href="/" class="logo">
        <img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Pinterest-logo.png" 
             alt="Pinterest" style="height: 30px; width: auto; vertical-align: middle;">
        Pinterest
      </a>
      <div class="nav-links">
          <a href="/feed" class="nav-link"><i class="bi bi-house-fill"></i> Feed</a>
          <a href="/profile" class="nav-link"><i class="bi bi-person-fill"></i> Profile</a>
          <a href="/posts" class="nav-link"><i class="bi bi-grid-fill"></i> Posts</a>
          <a href="/logout" class="btn-logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </div>
    </nav>

    <!-- Search Bar -->
    <div class="search-bar">
        <form action="/search" method="GET" style="display:flex; width:100%; justify-content:center;">
            <input type="text" name="q" placeholder="Search posts by caption..." 
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button type="submit"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <!-- Search result info -->
    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        <p class="search-result-text">
            Showing results for "<strong><%= searchQuery %></strong>" 
            — <a href="/feed">Clear search</a>
        </p>
    <% } %>

    <div class="container">

        <!-- Your uploaded posts -->
        <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
            <% posts.forEach(function(post) { %>
                <div class="box">
                    <img src="/images/uploads/<%= post.image %>" alt="<%= post.imageText %>">
                    <div class="caption">
                        <p><%= post.imageText %></p>
                        <small>by <strong><%= post.user ? post.user.username : 'Unknown' %></strong></small>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <!-- Unsplash posts -->
        <% if (typeof unsplashPosts !== 'undefined' && unsplashPosts && unsplashPosts.length > 0) { %>
            <% unsplashPosts.forEach(function(photo) { %>
                <% if (photo && photo.urls && photo.user) { %>
                    <div class="box" onclick="window.open('<%= photo.urls.full %>', '_blank')" style="cursor:pointer;">
                        <img src="<%= photo.urls.small %>" alt="<%= photo.alt_description || 'photo' %>">
                        <div class="caption">
                            <p><%= photo.alt_description || 'Beautiful photo' %></p>
                            <small>by <strong><%= photo.user.name %></strong> on Unsplash</small>
                        </div>
                    </div>
                <% } %>
            <% }) %>
        <% } %>

        <!-- No results -->
        <% if ((typeof posts === 'undefined' || !posts || posts.length === 0) && (typeof unsplashPosts === 'undefined' || !unsplashPosts || unsplashPosts.length === 0)) { %>
            <div class="no-results">
                <i class="bi bi-image" style="font-size:48px; color:#ddd;"></i>
                <p>No posts found. <a href="/feed">Go back to feed</a></p>
            </div>
        <% } %>

    </div>
</body>
</html>
